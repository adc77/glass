{
  "format": "seam-case",
  "version": 1,
  "name": "fail-then-release",
  "seed": 1842,
  "namespace": "sim-glass-fail",
  "clock": {"start_ns": 0, "epoch": "1970-01-01T00:00:00Z"},
  "initial_state": {},
  "arrivals": [
    {"at_ns": 0, "handler": "receive", "body": {"sample": "s1", "kind": "blood"}},
    {"at_ns": 1000000000, "handler": "reading", "body": {"sample": "s1", "value": 7}},
    {"at_ns": 7000000000, "handler": "reading", "body": {"sample": "s1", "value": 8}}
  ],
  "ports": {
    "bench": {
      "mode": "script",
      "replies": [
        {"match": {"kind": "blood"}, "response": {"status": "ready", "machine": "m1"}, "repeat": 1},
        {"match": {"kind": "blood"}, "response": {"status": "ready", "machine": "m2"}, "repeat": 1}
      ]
    },
    "qc": {
      "mode": "script",
      "replies": [
        {"match": {"kind": "blood", "value": 7}, "response": {"status": "fail"}, "repeat": 1},
        {"match": {"kind": "blood", "value": 8}, "response": {"status": "pass"}, "repeat": 1}
      ]
    },
    "report": {
      "mode": "script",
      "replies": [
        {"match": {"disposition": "released"}, "response": {"status": "filed"}, "repeat": 1}
      ]
    }
  },
  "stop": {"when": "quiescence"},
  "assertions": [
    {"op": "port_called", "port": "bench", "times": 2},
    {"op": "port_called", "port": "qc", "times": 2},
    {"op": "port_called", "port": "report", "times": 1, "match": {"disposition": "released"}},
    {"op": "timer_outcome", "name": "due-once", "outcome": "cancelled"},
    {"op": "timer_outcome", "name": "retest-once", "outcome": "fired"},
    {"op": "timer_outcome", "name": "due-retest", "outcome": "cancelled"},
    {"op": "state_is", "path": "sample.status", "value": "released"},
    {"op": "state_is", "path": "sample.retested", "value": true},
    {"op": "state_is", "path": "sample.machine", "value": "m2"},
    {"op": "stopped", "reason": "quiescence"}
  ]
}
